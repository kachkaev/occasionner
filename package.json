{
  "name": "@occasionner/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "changesets:publish": "changeset publish",
    "changesets:version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
    "fix": "npm-run-all2 --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --max-warnings=0 --fix",
    "fix:knip": "knip --fix",
    "fix:markdownlint": "markdownlint --dot --fix .",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --cache --write .",
    "lint": "npm-run-all2 --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --cache-strategy=content --dot --no-progress \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "knip",
    "lint:markdownlint": "markdownlint --dot .",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --cache --check .",
    "lint:tsc": "tsc --noEmit && pnpm --recursive --no-bail run lint:tsc",
    "prepare": "node .husky/install.mjs",
    "test": "pnpm --recursive --no-bail run test"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@kachkaev/prettier-config",
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@changesets/config": "4.0.0",
    "@cspell/dict-ru_ru": "2.3.2",
    "@kachkaev/eslint-config-base": "1.2.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.4.0",
    "cspell": "10.1.1",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "knip": "6.32.3",
    "lint-staged": "17.4.1",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
